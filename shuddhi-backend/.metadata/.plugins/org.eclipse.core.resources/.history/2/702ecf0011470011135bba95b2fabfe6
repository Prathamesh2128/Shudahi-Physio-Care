	public void run(ApplicationArguments args) throws Exception {
		seedPermission();
		seedRoles();
		log.info("Role and Permission seeding completed.");
	}

	private void seedPermission() {
		for (String[] p : ALL_PERMISSION) {
			if (permissionRepo.fingBySlug(p[2].isEmpty())) {
//				permissionRepo.save(new Permission(p[0], p[1], p[2], p[3]));
				permissionRepo
						.save(Permission.builder().module(p[0]).action(p[1]).slug(p[2]).description(p[3]).build());
			}
		}
	}

	private void seedRoles() {
		ROLE_PERMISSION_MAP.forEach((slug, permSlug)-> {
			Role role = roleRepo.finby
